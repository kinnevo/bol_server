{
  "name": "bol-game-server",
  "version": "1.0.0",
  "description": "Backend server for BOL multiplayer game with WebSocket support",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node test/run-all-tests.js",
    "test:unit": "node test/transcript-unit.test.js",
    "test:integration": "node test/transcript-integration.test.js",
    "test:transcripts": "node test/run-all-tests.js --all",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.85.0",
    "@langchain/core": "^1.1.4",
    "@langchain/openai": "^0.3.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "googleapis": "^166.0.0",
    "langchain": "^0.3.12",
    "node-pg-migrate": "^8.0.3",
    "openai": "^5.23.0",
    "pg": "^8.16.3",
    "redis": "^4.6.0",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "game",
    "websocket",
    "multiplayer",
    "nodejs"
  ],
